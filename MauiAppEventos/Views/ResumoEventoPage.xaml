<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.ResumoEventoPage"
             Title="Resumo do Evento"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="📋 Resumo do Evento"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Border Stroke="Gray" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 10" 
                    Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding Nome}"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" />

                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />
                    <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}" />

                    <Label Text="{Binding DuracaoEmDias, StringFormat='Duração: {0} dia(s)'}" 
                           FontAttributes="Bold" />

                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}" />
                    <Label Text="{Binding CustoPorParticipante, StringFormat='Valor por participante: {0:C}'}" />

                    <Label Text="{Binding CustoTotal, StringFormat='Custo Total: {0:C}'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>